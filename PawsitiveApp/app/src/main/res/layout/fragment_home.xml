<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hero"
            android:padding="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFESSIONAL • CARING • PRACTICAL"
                android:textColor="@color/brown"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Helping pets and their people thrive."
                android:textColor="@color/brown"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Welcome to Pawsitive Pet Academy — a friendly, professional academy designed to help pet owners build better routines, stronger relationships and confident, well-cared-for companions."
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnExploreCourses"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/tan"
                    android:text="Explore courses" />

                <Button
                    android:id="@+id/btnCalculateFees"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:strokeColor="@color/tan"
                    android:textColor="@color/brown"
                    android:text="Calculate my fees" />
            </LinearLayout>

            <ImageView
                android:layout_width="180dp"
                android:layout_height="96dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="Pawsitive Pet Academy logo"
                android:src="@drawable/pawsitive_logo" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="EXPLORE"
            android:textColor="@color/brown"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="Explore our pathways."
            android:textColor="@color/brown"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/pathwaySixMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Six-Month Programmes" android:textColor="@color/brown" android:textStyle="bold" android:textSize="16sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="In-depth obedience and grooming training." android:textColor="@color/muted" android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pathwaySixWeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Six-Week Course" android:textColor="@color/brown" android:textStyle="bold" android:textSize="16sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A focused foundation in puppy care." android:textColor="@color/muted" android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pathwayFeesCalculator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fees Calculator" android:textColor="@color/brown" android:textStyle="bold" android:textSize="16sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See your discount and total instantly." android:textColor="@color/muted" android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
